// ==UserScript==
// @name         SAID Bloxd
// @namespace    said
// @version      3.1.0
// @description  Box ESP | Head Aim | Silent | Killaura | SAID menu
// @author       said
// @match        *://*.bloxd.io/*
// @match        *://*.bloxd.com/*
// @match        *://*.bloxd.dev/*
// @match        *://*.bloxdhop.io/*
// @match        *://*.playbloxd.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  "use strict";

  const { defineProperty, values, getPrototypeOf, getOwnPropertyNames, keys } = Object;
  const { hypot, atan2, sin, cos, abs, min, max, random, PI } = Math;

  const CFG = {
    aimSmooth: 1.0,      // 1 = anında kafa
    aimFov: 180,
    aimRange: 32,
    aimDelay: 0,
    kaRange: 6.2,        // çok yüksek reach ban riski
    kaDelay: 70,
    kaJitter: 0.35,
    silent: true,
    boxColor: "rgba(255,40,40,0.98)",
    boxScale: 1.35,      // daha büyük kutu
    farScale: 1.25,
    panelW: 230
  };

  const state = {
    aimbot: true,
    silent: true,
    esp: true,
    killaura: true,
    menuOpen: true,
    _kaLast: 0,
    _aimLast: 0
  };

  const hooks = { noa: null, injected: false, method: "" };

  function spoofLocal() {
    try {
      const id = "p_" + random().toString(36).slice(2) + Date.now().toString(36);
      localStorage.setItem("bloxd_player_id", id);
      localStorage.setItem("bloxd_session", btoa(id + "|" + Date.now()));
      keys(localStorage).forEach(k => {
        const L = k.toLowerCase();
        if (L.includes("ban") || L.includes("kick") || L.includes("mute")) localStorage.removeItem(k);
      });
    } catch {}
  }
  spoofLocal();
  setInterval(spoofLocal, 45000);

  function onNoa(n, method) {
    if (hooks.injected || !n || !n.entities) return;
    hooks.noa = n;
    hooks.injected = true;
    hooks.method = method;
    window.noa = n;
    console.log("%c[SAID]%c " + method, "background:#000;color:#0f0;padding:2px 6px", "color:#0f0");
    setStatus(true);
  }

  (function injectCall() {
    let done = false;
    const orig = Function.prototype.call;
    defineProperty(Function.prototype, "call", {
      enumerable: false, configurable: true, writable: true,
      value: function (thisArg, ...args) {
        if (!done) {
          const c = args[0];
          if (c && c.entities && c.bloxd) {
            done = true;
            onNoa(c, "call");
            defineProperty(Function.prototype, "call", { value: orig, writable: true, configurable: true });
          }
        }
        return orig.apply(this, [thisArg, ...args]);
      }
    });
  })();

  setInterval(() => {
    if (hooks.injected) return;
    if (window.noa && window.noa.entities && window.noa.bloxd) {
      onNoa(window.noa, "window.noa");
      return;
    }
    try {
      for (const k of keys(window)) {
        const v = window[k];
        if (v && typeof v === "object" && v.entities && v.bloxd && v.camera) {
          onNoa(v, "scan:" + k);
          return;
        }
      }
    } catch {}
  }, 700);

  const game = {
    _attackCache: new WeakMap(),
    _heldCache: null,

    inGame() {
      return !!(hooks.noa && hooks.noa.bloxd && hooks.noa.bloxd.client);
    },
    getPos(id = 1) {
      try {
        const s = hooks.noa.entities.getState(id, "position");
        return s && s.position ? s.position : null;
      } catch { return null; }
    },
    isAlive(id = 1) {
      try {
        const s = hooks.noa.entities.getState(id, "genericLifeformState");
        return s ? s.isAlive !== false : true;
      } catch { return true; }
    },
    getAlivePlayers() {
      try {
        const raw = hooks.noa.bloxd.getPlayerIds ? hooks.noa.bloxd.getPlayerIds() : {};
        return values(raw).map(Number).filter(n => n && n !== 1 && this.isAlive(n));
      } catch { return []; }
    },
    getHeld(id = 1) {
      try {
        const comps = hooks.noa.entities.components;
        if (comps) {
          const comp = values(comps).find(c => {
            try { return values(c).some(v => v && typeof v === "object" && "fistItem" in v); }
            catch { return false; }
          });
          if (comp && comp.name) return hooks.noa.entities.getState(id, comp.name);
        }
        if (!this._heldCache) {
          this._heldCache = values(hooks.noa.entities).find(fn =>
            typeof fn === "function" && fn.length === 1 && String(fn).length < 90 && String(fn).includes(").")
          );
        }
        return this._heldCache ? this._heldCache(id) : null;
      } catch { return null; }
    },
    doSwing() {
      try {
        const held = this.getHeld(1);
        const std = held && (held._standardItem || (held.heldItemState && held.heldItemState._standardItem));
        if (std && typeof std.trySwingBlock === "function") std.trySwingBlock(Date.now());
        const ms = hooks.noa.entities.getState(1, "moveState");
        if (ms && typeof ms.setArmsAreSwinging === "function") ms.setArmsAreSwinging(true);
      } catch {}
    },
    doAttack(targetId, head = true) {
      try {
        const held = this.getHeld(1);
        if (!held) return;
        const fist = held.fistItem || (held.heldItemState && held.heldItemState.fistItem) || held;
        let attackFn = null;
        const proto = getPrototypeOf(fist);
        if (proto && this._attackCache.has(proto)) attackFn = this._attackCache.get(proto);
        else if (proto) {
          attackFn = getOwnPropertyNames(proto).map(k => fist[k])
            .find(f => typeof f === "function" && f.length === 3 && String(f).includes("canAttack"));
          if (!attackFn) attackFn = (typeof fist.doAttack === "function" && fist.doAttack) || null;
          if (attackFn) this._attackCache.set(proto, attackFn);
        }
        if (typeof attackFn !== "function") return;

        const self = this.getPos(1);
        const targ = this.getPos(targetId);
        if (!self || !targ) return;

        let dx = targ[0] - self[0];
        let dy = targ[1] - self[1] + (head ? 1.55 : 0.95);
        let dz = targ[2] - self[2];
        const d = hypot(dx, dy, dz) || 1;
        const j = CFG.kaJitter;
        if (j > 0) {
          dx += (random() - 0.5) * j;
          dy += (random() - 0.5) * j * 0.4;
          dz += (random() - 0.5) * j;
        }
        const dir = [dx / d, dy / d, dz / d];
        const mesh = head ? "HeadMesh" : "BodyMesh";
        try { attackFn.call(fist, dir, String(targetId), mesh); }
        catch {
          try { attackFn.call(fist, dir, String(targetId), "BodyMesh"); }
          catch { try { attackFn.call(fist, dir, String(targetId)); } catch {} }
        }
        this.doSwing();
      } catch {}
    },
    getCam() {
      return hooks.noa && hooks.noa.camera ? hooks.noa.camera : null;
    }
  };

  function angleDiff(a, b) {
    return atan2(sin(a - b), cos(a - b));
  }
  function dist(a, b) {
    if (!a || !b) return 1e9;
    return hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);
  }

  // AIMBOT — anında kafa
  function tickAimbot() {
    if (!state.aimbot || !game.inGame()) return;
    const now = Date.now();
    if (now - state._aimLast < CFG.aimDelay) return;
    state._aimLast = now;

    const self = game.getPos(1);
    const cam = game.getCam();
    if (!self || !cam) return;

    let best = null, bestD = CFG.aimRange;
    for (const id of game.getAlivePlayers()) {
      const p = game.getPos(id);
      if (!p) continue;
      const d = dist(self, p);
      if (d >= bestD) continue;
      bestD = d;
      best = p;
    }
    if (!best) return;

    const hx = best[0] - self[0];
    const hy = best[1] + 1.55 - self[1];
    const hz = best[2] - self[2];
    const wantYaw = atan2(hx, hz);
    const wantPitch = -atan2(hy, hypot(hx, hz));
    const s = CFG.aimSmooth;
    cam.heading += angleDiff(wantYaw, cam.heading) * s;
    cam.pitch += (max(-1.55, min(1.55, wantPitch)) - cam.pitch) * s;
  }

  // SILENT AIM — bakış bozmadan head hit
  function tickSilent() {
    if (!state.silent || !game.inGame()) return;
    // silent: saldırı anında yönü kafaya verir, kamera zorunlu değil
    // killaura ile birleşik çalışır
  }

  // KILL AURA
  function tickKillaura() {
    if (!state.killaura || !game.inGame()) return;
    const now = Date.now();
    if (now - state._kaLast < CFG.kaDelay) return;

    const self = game.getPos(1);
    if (!self) return;
    let closest = null, closestD = CFG.kaRange;
    for (const id of game.getAlivePlayers()) {
      const p = game.getPos(id);
      if (!p) continue;
      const d = dist(self, p);
      if (d < closestD) {
        closestD = d;
        closest = id;
      }
    }
    if (closest != null) {
      state._kaLast = now;
      // silent: kamera kaydırmadan head mesh
      if (state.silent) game.doAttack(closest, true);
      else {
        // aimbot zaten çevirmiş olabilir
        game.doAttack(closest, true);
      }
    }
  }

  // BOX ESP — büyük, uzaktan görünür
  let espCanvas, espCtx;
  function ensureEsp() {
    if (espCanvas) return;
    espCanvas = document.createElement("canvas");
    espCanvas.id = "said-esp";
    espCanvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998;";
    (document.body || document.documentElement).appendChild(espCanvas);
    espCtx = espCanvas.getContext("2d");
    const resize = () => {
      espCanvas.width = innerWidth;
      espCanvas.height = innerHeight;
    };
    resize();
    addEventListener("resize", resize);
  }

  function worldToScreen(pos) {
    const cam = game.getCam();
    const self = game.getPos(1);
    if (!cam || !self || !pos || !espCanvas) return null;
    const dx = pos[0] - self[0], dy = pos[1] - self[1], dz = pos[2] - self[2];
    const cosH = cos(-cam.heading), sinH = sin(-cam.heading);
    const cosP = cos(-cam.pitch), sinP = sin(-cam.pitch);
    let x = dx * cosH - dz * sinH;
    let z = dx * sinH + dz * cosH;
    let y = dy;
    const y2 = y * cosP - z * sinP;
    const z2 = y * sinP + z * cosP;
    if (z2 <= 0.12) return null;
    const fov = (72 * PI) / 180;
    const scale = (espCanvas.height / 2 / Math.tan(fov / 2)) * CFG.farScale;
    return {
      x: espCanvas.width / 2 + (x / z2) * scale,
      y: espCanvas.height / 2 - (y2 / z2) * scale
    };
  }

  function drawEsp() {
    if (!espCtx) return;
    espCtx.clearRect(0, 0, espCanvas.width, espCanvas.height);
    if (!state.esp || !game.inGame()) return;
    espCtx.strokeStyle = CFG.boxColor;
    espCtx.lineWidth = 2.5;
    espCtx.font = "bold 12px monospace";
    espCtx.fillStyle = CFG.boxColor;

    for (const id of game.getAlivePlayers()) {
      const p = game.getPos(id);
      if (!p) continue;
      const foot = worldToScreen(p);
      const head = worldToScreen([p[0], p[1] + 1.75, p[2]]);
      if (!foot || !head) continue;
      const h = abs(foot.y - head.y) * CFG.boxScale;
      const w = h * 0.55;
      const cx = (foot.x + head.x) / 2;
      const top = min(foot.y, head.y) - (h * 0.05);
      espCtx.strokeRect(cx - w / 2, top, w, h);
      const d = dist(game.getPos(1), p);
      espCtx.fillText("#" + id + " " + d.toFixed(1) + "m", cx - w / 2, top - 4);
    }
  }

  // SAID SİYAH MENÜ
  let statusDot, statusTxt;
  function setStatus(ok) {
    if (!statusDot) return;
    statusDot.style.background = ok ? "#0f0" : "#f33";
    if (statusTxt) statusTxt.textContent = ok ? "ok · " + hooks.method : "waiting…";
  }

  function buildUI() {
    if (document.getElementById("said-root")) return;
    const css = document.createElement("style");
    css.textContent = `
      #said-root{font-family:monospace;user-select:none}
      #said-panel{position:fixed;top:60px;right:12px;width:${CFG.panelW}px;z-index:10000;
        background:#000;border:1px solid #222;border-radius:8px;color:#fff;
        box-shadow:0 8px 32px rgba(0,0,0,.7);overflow:hidden}
      #said-head{padding:10px 12px;background:#000;border-bottom:1px solid #1a1a1a;
        display:flex;align-items:center;justify-content:space-between;cursor:move}
      #said-head b{letter-spacing:3px;color:#fff}
      #said-close{width:22px;height:22px;border-radius:50%;background:#111;border:1px solid #333;
        display:flex;align-items:center;justify-content:center;cursor:pointer}
      #said-body{padding:8px 10px 12px;display:flex;flex-direction:column;gap:6px}
      .said-row{display:flex;align-items:center;justify-content:space-between;
        padding:9px 10px;background:#0a0a0a;border:1px solid #1a1a1a;border-radius:6px;cursor:pointer}
      .said-row:hover{background:#121212}
      .said-sw{width:34px;height:18px;border-radius:9px;background:#222;border:1px solid #333;position:relative}
      .said-sw::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#666;transition:.15s}
      .said-row.on .said-sw{background:#fff;border-color:#fff}
      .said-row.on .said-sw::after{transform:translateX(16px);background:#000}
      #said-status{display:flex;align-items:center;gap:6px;padding:0 12px 8px;font-size:10px;color:#666}
      #said-status i{width:7px;height:7px;border-radius:50%;background:#f33;display:inline-block}
      #said-circle{position:fixed;bottom:16px;right:16px;width:48px;height:48px;border-radius:50%;
        background:#000;border:2px solid #fff;color:#fff;display:none;align-items:center;
        justify-content:center;font:700 13px monospace;cursor:pointer;z-index:10000}
      #said-foot{padding:0 12px 10px;font-size:10px;color:#444}
    `;
    document.documentElement.appendChild(css);

    const root = document.createElement("div");
    root.id = "said-root";
    root.innerHTML = `
      <div id="said-circle">S</div>
      <div id="said-panel">
        <div id="said-head"><b>SAID</b><span id="said-close">×</span></div>
        <div id="said-status"><i id="said-dot"></i><span id="said-txt">waiting…</span></div>
        <div id="said-body">
          <div class="said-row on" data-m="aimbot"><span>Aimbot Head</span><div class="said-sw"></div></div>
          <div class="said-row on" data-m="silent"><span>Silent Aim</span><div class="said-sw"></div></div>
          <div class="said-row on" data-m="esp"><span>Box ESP</span><div class="said-sw"></div></div>
          <div class="said-row on" data-m="killaura"><span>Kill Aura</span><div class="said-sw"></div></div>
        </div>
        <div id="said-foot">M = menü · sunucu banını client engelleyemez</div>
      </div>
    `;
    document.documentElement.appendChild(root);

    statusDot = document.getElementById("said-dot");
    statusTxt = document.getElementById("said-txt");
    const panel = document.getElementById("said-panel");
    const circle = document.getElementById("said-circle");
    const head = document.getElementById("said-head");

    function setOpen(v) {
      state.menuOpen = v;
      panel.style.display = v ? "block" : "none";
      circle.style.display = v ? "none" : "flex";
    }
    document.getElementById("said-close").onclick = e => { e.stopPropagation(); setOpen(false); };
    circle.onclick = () => setOpen(true);

    let drag = false, ox = 0, oy = 0;
    head.onpointerdown = e => {
      if (e.target.id === "said-close") return;
      drag = true;
      const r = panel.getBoundingClientRect();
      ox = e.clientX - r.left; oy = e.clientY - r.top;
      head.setPointerCapture(e.pointerId);
    };
    head.onpointermove = e => {
      if (!drag) return;
      panel.style.left = max(0, e.clientX - ox) + "px";
      panel.style.top = max(0, e.clientY - oy) + "px";
      panel.style.right = "auto";
    };
    head.onpointerup = () => { drag = false; };

    root.querySelectorAll(".said-row").forEach(row => {
      row.onclick = () => {
        const m = row.dataset.m;
        state[m] = !state[m];
        row.classList.toggle("on", state[m]);
        if (m === "esp") {
          ensureEsp();
          if (!state.esp && espCtx) espCtx.clearRect(0, 0, espCanvas.width, espCanvas.height);
        }
      };
    });
    setOpen(true);
  }

  addEventListener("keydown", e => {
    if (e.code === "KeyM") {
      const panel = document.getElementById("said-panel");
      const circle = document.getElementById("said-circle");
      if (!panel) return;
      state.menuOpen = !state.menuOpen;
      panel.style.display = state.menuOpen ? "block" : "none";
      circle.style.display = state.menuOpen ? "none" : "flex";
    }
  }, true);

  function loop() {
    if (hooks.injected && game.inGame()) {
      setStatus(true);
      tickAimbot();
      tickSilent();
      tickKillaura();
      drawEsp();
    }
    requestAnimationFrame(loop);
  }

  function boot() {
    buildUI();
    ensureEsp();
    loop();
  }
  if (document.body) boot();
  else addEventListener("DOMContentLoaded", boot);
})();
