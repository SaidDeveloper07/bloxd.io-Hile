// ==UserScript==
// @name         SAID Bloxd Pro
// @namespace    said
// @version      4.2.0
// @description  Clean ESP | Head-only aim | Killaura | Fly fix
// @author       said
// @match        *://*.bloxd.io/*
// @match        *://*.bloxd.com/*
// @match        *://*.bloxd.dev/*
// @match        *://*.bloxdhop.io/*
// @match        *://*.playbloxd.com/*
// @run-at       document-start
// @grant        none
// ==/UserScript==

(() => {
  "use strict";

  const PASS = "said12";
  const { defineProperty, values, getPrototypeOf, getOwnPropertyNames, keys } = Object;
  const { hypot, atan2, sin, cos, abs, min, max, random, PI } = Math;

  const CFG = {
    aimSmooth: 0.45,
    aimFov: 40,          // dar FOV = rastgele hedef yok
    aimRange: 18,
    headY: 1.48,         // tam kafa
    pitchMin: -0.55,
    pitchMax: 0.35,      // yukarı kaçmayı kes
    kaRange: 5.5,
    kaDelay: 90,
    kaJitter: 0.12,
    flySpeed: 0.72,
    boxW: 0.38,          // dar kutu
    maxEsp: 55
  };

  const state = {
    unlocked: false,
    esp: false,
    aimbot: false,
    killaura: false,
    fly: false,
    menuOpen: true,
    mouseDown: false,
    _kaLast: 0
  };

  const keysDown = { space: false, shift: false, w: false, a: false, s: false, d: false };
  const hooks = { noa: null, injected: false, method: "" };

  function onNoa(n, method) {
    if (hooks.injected || !n || !n.entities) return;
    hooks.noa = n;
    hooks.injected = true;
    hooks.method = method;
    window.noa = n;
    setStatus(true);
  }

  (function injectCall() {
    let done = false;
    const orig = Function.prototype.call;
    defineProperty(Function.prototype, "call", {
      enumerable: false, configurable: true, writable: true,
      value: function (thisArg, ...args) {
        if (!done) {
          const c = args[0];
          if (c && c.entities && c.bloxd) {
            done = true;
            onNoa(c, "call");
            defineProperty(Function.prototype, "call", { value: orig, writable: true, configurable: true });
          }
        }
        return orig.apply(this, [thisArg, ...args]);
      }
    });
  })();

  setInterval(() => {
    if (hooks.injected) return;
    if (window.noa && window.noa.entities && window.noa.bloxd) return onNoa(window.noa, "window.noa");
    try {
      for (const k of keys(window)) {
        const v = window[k];
        if (v && typeof v === "object" && v.entities && v.bloxd && v.camera) {
          onNoa(v, "scan:" + k);
          return;
        }
      }
    } catch {}
  }, 700);

  const game = {
    _attackCache: new WeakMap(),
    _heldCache: null,

    inGame() {
      return !!(hooks.noa && hooks.noa.bloxd && hooks.noa.bloxd.client);
    },
    getPos(id = 1) {
      try {
        const s = hooks.noa.entities.getState(id, "position");
        return s && s.position ? s.position : null;
      } catch { return null; }
    },
    isAlive(id = 1) {
      try {
        const s = hooks.noa.entities.getState(id, "genericLifeformState");
        return s ? s.isAlive !== false : true;
      } catch { return false; }
    },
    // SADECE gerçek diğer oyuncular
    getAlivePlayers() {
      try {
        if (!this.inGame()) return [];
        const me = this.getPos(1);
        if (!me) return [];
        const raw = hooks.noa.bloxd.getPlayerIds ? hooks.noa.bloxd.getPlayerIds() : {};
        if (!raw || typeof raw !== "object") return [];
        const ids = values(raw).map(Number).filter(n => n && n !== 1 && isFinite(n));
        const out = [];
        const seen = new Set();
        for (const id of ids) {
          if (!this.isAlive(id)) continue;
          const p = this.getPos(id);
          if (!p) continue;
          if (!isFinite(p[0]) || !isFinite(p[1]) || !isFinite(p[2])) continue;
          // çöp / boş entity
          if (abs(p[0]) + abs(p[2]) < 0.2) continue;
          const d = hypot(p[0] - me[0], p[1] - me[1], p[2] - me[2]);
          if (d < 0.8 || d > CFG.maxEsp) continue;
          // y çok absürt = mob/prop değil player
          if (abs(p[1] - me[1]) > 40) continue;
          const key = id + ":" + p[0].toFixed(0) + ":" + p[2].toFixed(0);
          if (seen.has(key)) continue;
          seen.add(key);
          out.push({ id, p, d });
        }
        return out;
      } catch { return []; }
    },
    getHeld(id = 1) {
      try {
        const comps = hooks.noa.entities.components;
        if (comps) {
          const comp = values(comps).find(c => {
            try { return values(c).some(v => v && typeof v === "object" && "fistItem" in v); }
            catch { return false; }
          });
          if (comp && comp.name) return hooks.noa.entities.getState(id, comp.name);
        }
        if (!this._heldCache) {
          this._heldCache = values(hooks.noa.entities).find(fn =>
            typeof fn === "function" && fn.length === 1 && String(fn).length < 90 && String(fn).includes(").")
          );
        }
        return this._heldCache ? this._heldCache(id) : null;
      } catch { return null; }
    },
    doSwing() {
      try {
        const held = this.getHeld(1);
        const std = held && (held._standardItem || (held.heldItemState && held.heldItemState._standardItem));
        if (std && typeof std.trySwingBlock === "function") std.trySwingBlock(Date.now());
      } catch {}
    },
    // SADECE HeadMesh
    doAttack(targetId) {
      try {
        const held = this.getHeld(1);
        if (!held) return;
        const fist = held.fistItem || (held.heldItemState && held.heldItemState.fistItem) || held;
        let attackFn = null;
        const proto = getPrototypeOf(fist);
        if (proto && this._attackCache.has(proto)) attackFn = this._attackCache.get(proto);
        else if (proto) {
          attackFn = getOwnPropertyNames(proto).map(k => fist[k])
            .find(f => typeof f === "function" && f.length === 3 && String(f).includes("canAttack"));
          if (!attackFn && typeof fist.doAttack === "function") attackFn = fist.doAttack;
          if (attackFn) this._attackCache.set(proto, attackFn);
        }
        if (typeof attackFn !== "function") return;
        const self = this.getPos(1);
        const targ = this.getPos(targetId);
        if (!self || !targ) return;
        let dx = targ[0] - self[0];
        let dy = targ[1] - self[1] + CFG.headY;
        let dz = targ[2] - self[2];
        const d = hypot(dx, dy, dz) || 1;
        dx += (random() - 0.5) * CFG.kaJitter;
        dz += (random() - 0.5) * CFG.kaJitter;
        const dir = [dx / d, dy / d, dz / d];
        // sadece kafa
        try { attackFn.call(fist, dir, String(targetId), "HeadMesh"); }
        catch {
          try { attackFn.call(fist, dir, String(targetId), "HeadMesh"); } catch {}
        }
        this.doSwing();
      } catch {}
    },
    getCam() {
      return hooks.noa && hooks.noa.camera ? hooks.noa.camera : null;
    },
    getCamPos() {
      try {
        const cam = this.getCam();
        if (cam && typeof cam.getPosition === "function") {
          const p = cam.getPosition();
          if (p && isFinite(p[0])) return [p[0], p[1], p[2]];
        }
        if (cam && cam.position && isFinite(cam.position[0])) {
          return [cam.position[0], cam.position[1], cam.position[2]];
        }
        const me = this.getPos(1);
        return me ? [me[0], me[1] + 1.55, me[2]] : null;
      } catch {
        const me = this.getPos(1);
        return me ? [me[0], me[1] + 1.55, me[2]] : null;
      }
    },
    getPhysicsBody() {
      try {
        const phys = hooks.noa.entities.getPhysics(1);
        return phys && phys.body ? phys.body : null;
      } catch { return null; }
    }
  };

  function angleDiff(a, b) {
    return atan2(sin(a - b), cos(a - b));
  }

  function pickTarget(self, cam, maxRange, needFov) {
    const list = game.getAlivePlayers();
    const fovRad = (CFG.aimFov * PI) / 180;
    let best = null, bestScore = 1e9;
    for (const t of list) {
      if (t.d > maxRange) continue;
      const hx = t.p[0] - self[0];
      const hz = t.p[2] - self[2];
      const yaw = atan2(hx, hz);
      const yawErr = abs(angleDiff(yaw, cam.heading));
      if (needFov && yawErr > fovRad / 2) continue;
      const score = yawErr * 10 + t.d * 0.2;
      if (score < bestScore) {
        bestScore = score;
        best = t;
      }
    }
    return best;
  }

  // AIMBOT — LMB, sadece kafa, pitch kilitli
  function tickAimbot() {
    if (!state.unlocked || !state.aimbot || !game.inGame()) return;
    if (!state.mouseDown) return;

    const self = game.getPos(1);
    const cam = game.getCam();
    if (!self || !cam) return;

    const t = pickTarget(self, cam, CFG.aimRange, true);
    if (!t) return;

    const hx = t.p[0] - self[0];
    const hy = t.p[1] + CFG.headY - self[1];
    const hz = t.p[2] - self[2];
    const horiz = hypot(hx, hz) || 0.001;
    const wantYaw = atan2(hx, hz);
    let wantPitch = -atan2(hy, horiz);
    wantPitch = max(CFG.pitchMin, min(CFG.pitchMax, wantPitch));

    const s = CFG.aimSmooth;
    cam.heading += angleDiff(wantYaw, cam.heading) * s;
    cam.pitch += (wantPitch - cam.pitch) * s;
    // ekstra güvenlik: pitch asla aşırı yukarı
    if (cam.pitch < CFG.pitchMin) cam.pitch = CFG.pitchMin;
    if (cam.pitch > CFG.pitchMax) cam.pitch = CFG.pitchMax;
  }

  function tickKillaura() {
    if (!state.unlocked || !state.killaura || !game.inGame()) return;
    const now = Date.now();
    if (now - state._kaLast < CFG.kaDelay) return;
    const self = game.getPos(1);
    const cam = game.getCam();
    if (!self || !cam) return;
    // yakın + bakış yönü
    const t = pickTarget(self, cam, CFG.kaRange, true);
    if (!t) return;
    state._kaLast = now;
    game.doAttack(t.id);
  }

  // FLY FIX — her frame velocity + gravity kapat
  function tickFly() {
    if (!state.unlocked || !state.fly || !game.inGame()) return;
    const body = game.getPhysicsBody();
    const cam = game.getCam();
    if (!body || !cam) return;

    try {
      // yerçekimi / falling kapat
      if (body.gravity !== undefined) body.gravity = 0;
      if (body.gravityMultiplier !== undefined) body.gravityMultiplier = 0;
      if (typeof body.setGravity === "function") body.setGravity(0);
    } catch {}

    if (!body.velocity) return;

    // dikey
    if (keysDown.space) body.velocity[1] = CFG.flySpeed * 18;
    else if (keysDown.shift) body.velocity[1] = -CFG.flySpeed * 18;
    else body.velocity[1] = 0;

    // yatay WASD
    let mx = 0, mz = 0;
    if (keysDown.w) { mx += sin(cam.heading); mz += cos(cam.heading); }
    if (keysDown.s) { mx -= sin(cam.heading); mz -= cos(cam.heading); }
    if (keysDown.a) { mx += cos(cam.heading); mz -= sin(cam.heading); }
    if (keysDown.d) { mx -= cos(cam.heading); mz += sin(cam.heading); }
    const len = hypot(mx, mz);
    if (len > 0.01) {
      body.velocity[0] = (mx / len) * CFG.flySpeed * 16;
      body.velocity[2] = (mz / len) * CFG.flySpeed * 16;
    } else {
      body.velocity[0] = 0;
      body.velocity[2] = 0;
    }

    // alternatif path: noa.ents
    try {
      if (hooks.noa.ents && hooks.noa.ents.getPhysics) {
        const b2 = hooks.noa.ents.getPhysics(1);
        if (b2 && b2.body && b2.body.velocity) {
          b2.body.velocity[0] = body.velocity[0];
          b2.body.velocity[1] = body.velocity[1];
          b2.body.velocity[2] = body.velocity[2];
        }
      }
    } catch {}
  }

  let espCanvas, espCtx;
  function ensureEsp() {
    if (espCanvas) return;
    espCanvas = document.createElement("canvas");
    espCanvas.id = "said-esp";
    espCanvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9998";
    (document.body || document.documentElement).appendChild(espCanvas);
    espCtx = espCanvas.getContext("2d");
    const resize = () => { espCanvas.width = innerWidth; espCanvas.height = innerHeight; };
    resize();
    addEventListener("resize", resize);
  }

  function worldToScreen(wx, wy, wz) {
    const cam = game.getCam();
    const origin = game.getCamPos();
    if (!cam || !origin || !espCanvas) return null;
    const dx = wx - origin[0], dy = wy - origin[1], dz = wz - origin[2];
    const cosH = cos(-cam.heading), sinH = sin(-cam.heading);
    const cosP = cos(-cam.pitch), sinP = sin(-cam.pitch);
    let x = dx * cosH - dz * sinH;
    let z = dx * sinH + dz * cosH;
    let y = dy;
    const y2 = y * cosP - z * sinP;
    const z2 = y * sinP + z * cosP;
    if (z2 <= 0.25) return null;
    const fov = (70 * PI) / 180;
    const scale = espCanvas.height / 2 / Math.tan(fov / 2);
    const sx = espCanvas.width / 2 + (x / z2) * scale;
    const sy = espCanvas.height / 2 - (y2 / z2) * scale;
    if (!isFinite(sx) || !isFinite(sy)) return null;
    return { x: sx, y: sy };
  }

  function drawEsp() {
    if (!espCtx) return;
    espCtx.clearRect(0, 0, espCanvas.width, espCanvas.height);
    if (!state.unlocked || !state.esp || !game.inGame()) return;

    espCtx.strokeStyle = "rgba(255,50,50,0.92)";
    espCtx.fillStyle = "rgba(255,50,50,0.92)";
    espCtx.lineWidth = 1.8;
    espCtx.font = "10px monospace";

    for (const { p, d } of game.getAlivePlayers()) {
      const foot = worldToScreen(p[0], p[1], p[2]);
      const head = worldToScreen(p[0], p[1] + 1.65, p[2]);
      if (!foot || !head) continue;
      let h = abs(foot.y - head.y);
      if (h < 12 || h > 220) continue;
      // küçük kutu
      h *= 0.92;
      const w = max(6, h * CFG.boxW);
      const cx = (foot.x + head.x) / 2;
      const top = min(foot.y, head.y);

      const c = max(2, w * 0.28);
      espCtx.beginPath();
      espCtx.moveTo(cx - w / 2, top + c);
      espCtx.lineTo(cx - w / 2, top);
      espCtx.lineTo(cx - w / 2 + c, top);
      espCtx.moveTo(cx + w / 2 - c, top);
      espCtx.lineTo(cx + w / 2, top);
      espCtx.lineTo(cx + w / 2, top + c);
      espCtx.moveTo(cx - w / 2, top + h - c);
      espCtx.lineTo(cx - w / 2, top + h);
      espCtx.lineTo(cx - w / 2 + c, top + h);
      espCtx.moveTo(cx + w / 2 - c, top + h);
      espCtx.lineTo(cx + w / 2, top + h);
      espCtx.lineTo(cx + w / 2, top + h - c);
      espCtx.stroke();
      espCtx.fillText(d.toFixed(0) + "m", cx - w / 2, top - 3);
    }
  }

  let statusDot, statusTxt;
  function setStatus(ok) {
    if (!statusDot) return;
    statusDot.style.background = ok ? "#0f0" : "#f33";
    if (statusTxt) statusTxt.textContent = ok ? "ok · " + hooks.method : "waiting…";
  }

  function buildLock() {
    if (document.getElementById("said-lock")) return;
    const el = document.createElement("div");
    el.id = "said-lock";
    el.style.cssText = "position:fixed;inset:0;z-index:100001;background:rgba(0,0,0,.93);display:flex;align-items:center;justify-content:center;font-family:monospace";
    el.innerHTML = `
      <div style="background:#050505;border:1px solid #222;padding:20px;border-radius:10px;width:260px;text-align:center">
        <div style="letter-spacing:4px;color:#fff;margin-bottom:12px">SAID</div>
        <input id="said-pass" type="password" placeholder="said12" style="width:100%;padding:10px;background:#0a0a0a;border:1px solid #2a2a2a;color:#fff;margin-bottom:8px">
        <button id="said-go" style="width:100%;padding:10px;background:#0a0a0a;color:#ff3030;border:1px solid #ff3030;cursor:pointer">UNLOCK</button>
        <div id="said-err" style="color:#f44;font-size:11px;margin-top:8px"></div>
      </div>`;
    document.documentElement.appendChild(el);
    function unlock() {
      if ((document.getElementById("said-pass").value || "").trim() === PASS) {
        state.unlocked = true;
        el.remove();
        buildUI();
        ensureEsp();
      } else document.getElementById("said-err").textContent = "yanlış";
    }
    document.getElementById("said-go").onclick = unlock;
    document.getElementById("said-pass").onkeydown = e => { if (e.key === "Enter") unlock(); };
  }

  function buildUI() {
    if (document.getElementById("said-root")) return;
    const css = document.createElement("style");
    css.textContent = `
      #said-root{font-family:monospace;user-select:none}
      #said-panel{position:fixed;top:58px;right:12px;width:220px;z-index:10000;background:#050505;
        border:1px solid #1c1c1c;border-radius:8px;color:#ddd;overflow:hidden}
      #said-head{padding:10px 12px;border-bottom:1px solid #181818;display:flex;justify-content:space-between;cursor:move}
      #said-head b{letter-spacing:3px;color:#fff}
      #said-close{width:22px;height:22px;border-radius:50%;border:1px solid #333;display:flex;align-items:center;justify-content:center;cursor:pointer}
      #said-body{padding:8px 10px;display:flex;flex-direction:column;gap:5px}
      .said-row{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:#0a0a0a;border:1px solid #161616;border-radius:5px;cursor:pointer;font-size:12px}
      .said-sw{width:32px;height:16px;border-radius:8px;background:#1a1a1a;position:relative}
      .said-sw::after{content:"";position:absolute;top:2px;left:2px;width:12px;height:12px;border-radius:50%;background:#555;transition:.15s}
      .said-row.on .said-sw{background:#c02020}
      .said-row.on .said-sw::after{transform:translateX(16px);background:#fff}
      #said-status{display:flex;align-items:center;gap:6px;padding:0 12px 8px;font-size:10px;color:#555}
      #said-status i{width:6px;height:6px;border-radius:50%;background:#f33;display:inline-block}
      #said-circle{position:fixed;bottom:14px;right:14px;width:44px;height:44px;border-radius:50%;background:#050505;border:1px solid #c02020;color:#c02020;display:none;align-items:center;justify-content:center;font:700 11px monospace;cursor:pointer;z-index:10000}
      #said-foot{padding:0 12px 10px;font-size:9px;color:#333}
    `;
    document.documentElement.appendChild(css);
    const root = document.createElement("div");
    root.id = "said-root";
    root.innerHTML = `
      <div id="said-circle">S</div>
      <div id="said-panel">
        <div id="said-head"><b>SAID</b><span id="said-close">×</span></div>
        <div id="said-status"><i id="said-dot"></i><span id="said-txt">waiting…</span></div>
        <div id="said-body">
          <div class="said-row" data-m="esp"><span>ESP</span><div class="said-sw"></div></div>
          <div class="said-row" data-m="aimbot"><span>HS Aim (LMB)</span><div class="said-sw"></div></div>
          <div class="said-row" data-m="killaura"><span>Kill Aura</span><div class="said-sw"></div></div>
          <div class="said-row" data-m="fly"><span>Fly WASD</span><div class="said-sw"></div></div>
        </div>
        <div id="said-foot">M menü · Space↑ Shift↓ · sadece kafa HS</div>
      </div>`;
    document.documentElement.appendChild(root);

    statusDot = document.getElementById("said-dot");
    statusTxt = document.getElementById("said-txt");
    const panel = document.getElementById("said-panel");
    const circle = document.getElementById("said-circle");
    const head = document.getElementById("said-head");

    function setOpen(v) {
      state.menuOpen = v;
      panel.style.display = v ? "block" : "none";
      circle.style.display = v ? "none" : "flex";
    }
    document.getElementById("said-close").onclick = e => { e.stopPropagation(); setOpen(false); };
    circle.onclick = () => setOpen(true);

    let drag = false, ox = 0, oy = 0;
    head.onpointerdown = e => {
      if (e.target.id === "said-close") return;
      drag = true;
      const r = panel.getBoundingClientRect();
      ox = e.clientX - r.left; oy = e.clientY - r.top;
      head.setPointerCapture(e.pointerId);
    };
    head.onpointermove = e => {
      if (!drag) return;
      panel.style.left = max(0, e.clientX - ox) + "px";
      panel.style.top = max(0, e.clientY - oy) + "px";
      panel.style.right = "auto";
    };
    head.onpointerup = () => { drag = false; };

    root.querySelectorAll(".said-row").forEach(row => {
      row.onclick = () => {
        const m = row.dataset.m;
        state[m] = !state[m];
        row.classList.toggle("on", state[m]);
      };
    });
    setOpen(true);
  }

  addEventListener("mousedown", e => { if (e.button === 0) state.mouseDown = true; }, true);
  addEventListener("mouseup", e => { if (e.button === 0) state.mouseDown = false; }, true);

  addEventListener("keydown", e => {
    if (e.code === "Space") { keysDown.space = true; if (state.fly) e.preventDefault(); }
    if (e.code === "ShiftLeft" || e.code === "ShiftRight") keysDown.shift = true;
    if (e.code === "KeyW") keysDown.w = true;
    if (e.code === "KeyA") keysDown.a = true;
    if (e.code === "KeyS") keysDown.s = true;
    if (e.code === "KeyD") keysDown.d = true;
    if (e.code === "KeyM" && state.unlocked) {
      const panel = document.getElementById("said-panel");
      const circle = document.getElementById("said-circle");
      if (!panel) return;
      state.menuOpen = !state.menuOpen;
      panel.style.display = state.menuOpen ? "block" : "none";
      circle.style.display = state.menuOpen ? "none" : "flex";
    }
  }, true);

  addEventListener("keyup", e => {
    if (e.code === "Space") keysDown.space = false;
    if (e.code === "ShiftLeft" || e.code === "ShiftRight") keysDown.shift = false;
    if (e.code === "KeyW") keysDown.w = false;
    if (e.code === "KeyA") keysDown.a = false;
    if (e.code === "KeyS") keysDown.s = false;
    if (e.code === "KeyD") keysDown.d = false;
  }, true);

  function loop() {
    if (hooks.injected && game.inGame() && state.unlocked) {
      setStatus(true);
      tickAimbot();
      tickKillaura();
      tickFly();
      drawEsp();
    }
